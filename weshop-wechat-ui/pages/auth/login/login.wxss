.container {
  box-sizing: border-box;
  background-color: #fff;
  font-family: PingFangSC-Light,helvetica,'Heiti SC';
} 

.button-primary {
  margin-top: 10px;
  width: 90%;
  background-color:#07C160;
  color: white;
}
 
.button-primary-hover {
  background: #06AD56;
}

.l-view {
  text-align:center;
  margin-top:20rpx;
  margin-bottom:20px;
}


.dialog-login{
  width: 100%;
  height: 100%;
  position: fixed;
  top: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5); 
  display: flex;
  justify-content: center;
  align-items: center;
}


.dialog-login .dialog-body{
  width: 540rpx;
  height: auto;
  overflow: hidden;
  background: #fff;
  border-radius: 5px;
  padding: 40rpx;
}

.dialog-login .dialog-body .title{
  width: 100%;
  text-align: center;
  line-height: 60rpx;
}

.dialog-login .dialog-body .content{
  width: 100%;
}

.dialog-login .dialog-body button{
  margin-top: 30rpx;
}