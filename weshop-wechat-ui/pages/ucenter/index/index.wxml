<view class="container">
  <view class="profile-info">
    <image
      bindtap="chooseAvatar"
      class="avatar"
      src="{{avataImagePath}}"
    ></image>
    <view class="info">
      <text class='name' bindtap='onUserInfoClick'>{{ userInfo.nickname || '点击登录' }}</text>
      <!-- <text class='level' bindtap='onUserInfoClick' > {{ userInfo.level}}</text> -->
    </view>

    <!-- <image bindtap="onUserInfoClick" class='btn' src='/static/images/address_right.png'></image> -->
    <view>
      <text class='jifen' style="font-family:fantasy;font-size:41px;color: darkcyan;">{{ userInfo.points === undefined ? 0 : userInfo.points }}</text>
      <text class='jifen' style="font-family:fantasy;font-size:17px;color: darkcyan;">分</text>
    </view>
  </view>

  <view class="user-menu">
    <view class="item">
      <navigator url="/pages/ucenter/collect/collect" class="a">
        <text class="icon address"></text>
        <text class="txt">我的收藏</text>
