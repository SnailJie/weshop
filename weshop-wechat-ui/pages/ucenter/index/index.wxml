    <view class="item ">
      <navigator
        url="url"
        class="a"
        bindtap="showModal"
      >
        <text class="icon kefu"></text>
        <text class="txt">联系我们</text>
      </navigator>
      <!-- 模态对话框 -->
      <cover-view wx:if="{{isModalVisible}}" class="modal">
        <cover-view class="modal-content">
          <cover-view class="modal-body">微信联系:Snail_JR</cover-view>
