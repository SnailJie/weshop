<view class="container" style="position: relative;">
  <!-- 顶部图片 -->
  <swiper
    wx:if="{{downloadImgs && downloadImgs.length > 0}}"
    class="post-image"
    style="height:300px;margin-bottom: -30px;"
    indicator-dots="{{true}}"
    autoplay="{{true}}"
    interval="3000"
    duration="500"
    indicator-dots="{{false}}"
  >
    <block wx:for="{{downloadImgs}}" wx:key="index">
      <swiper-item>
        <image
          src="{{item}}"
          class="post-image"
          mode="aspectFill"
        ></image>
      </swiper-item>
    </block>
  </swiper>
  <!-- 中间内容 -->
  <block>
    <view class="post-content" style="width: 100%;">
      <view
        wx:if="{{postDetail.title}}"
        class="fall-title   sa-wrap"
        style=" font-size: 30rpx;font-weight: 600;color: #333; margin-bottom: 12px;"
      >
        <navigator url="url" class="fall-title">{{postDetail.title}}</navigator>
      </view>
      <rich-text style="font-size:31rpx;" nodes="{{postDetail.content}}"></rich-text>
      <!-- 如果内容中包含多张图片，你可能需要遍历一个图片数组并显示它们 -->
    </view>
  </block>

  <!-- 作者信息 -->
  <view class="fall-bottom" style="margin-top: 10%;  display: flex;  justify-content: flex-end; align-items: center;">
    <view class="fall-toux-name">
      <image class="fall-toux" src="{{postDetail.userInfoDTO.avatar}}"></image>
      <view style="display: flex; flex-direction: column;">
        <text class="fall-name">{{postDetail.userInfoDTO.nickName}}</text>
        <text style="font-size:24rpx; color:lightgray; margin-left:10px;font-weight: bold;">{{createTime}}</text>
      </view>
    </view>

    <!-- <button bindtap="likePost" style="border-width: 0; border-style: none; margin-left: 120px; font-size: smaller;" >点赞</button> -->
    <view
      class="fall-love-num"
      style="margin-left: 150px;"
      bindtap="likePost"
    >
      <!-- <text  class="cuIcon-like lg text-gray"></text> -->
      <text wx:if="{{isLike == 1}}" class="cuIcon-likefill lg text-red"></text>
      <text wx:if="{{isLike == 0}}" class="cuIcon-like lg text-gray"></text>
      <text class="fall-num">{{postDetail.likeNum||0}}</text>
    </view>
  </view>
  <view class="divider" style="  justify-content: center;  align-items: center;  "></view>
  <!-- 历史评论 -->
  <scroll-view class="comments">
    <text class="t" style="font-weight: bolder;">评论区</text>
    <view class="has-comments" wx:if="{{commentList.length > 0 }}">
      <view class="h" style=" margin-bottom: 20px;">
      </view>
      <view class="b">
        <view
          class="item"
          wx:for="{{commentList}}"
          wx:key="{{item.id}}"
        >
          <view class="info" style="margin-bottom: 10px;">
            <view class="user">
              <image
                class="avatar"
                style="width:20px; height:20px;"
                src="{{item.creator.avatar}}"
              ></image>
              <text class="nickname" style="font-size:23rpx; color: lightgray">{{item.creator.nickName}}</text>
              <view style="display: flex;">
                <view class="comment" style="font-size: 25rpx; margin-left: 40px; font-family:sans-serif"> {{item.content}} </view>
                <view class="time" style="font-size: 23rpx; color: lightgray;margin-left: 10px;">{{item.gmtCreate}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="no-comments" wx:else="">
      <view class="b">
        <image class="icon" src="http://yanxuan.nosdn.127.net/hxm/yanxuan-wap/p/20161201/style/img/icon-normal/no-comment-560f87660a.png"></image>
      </view>
    </view>
  </scroll-view>
  <view style="height: 40px;"></view>
</view>

<!-- 评论信息 -->
<view class="input-container" style="width: 100%; position: fixed;bottom: 0px; ">
  <view class="footer-item" style="display: flex;    width: 100%">
    <input
      class="weui-input"
      value="{{inputContent}}"
      name="title"
      style="box-shadow: 0 -2px 5px rgba(0, 0, 0, 0.1); height: 40px; width: 70%; background-color: rgb(228, 226, 226);    border-radius: 5px 20px 5px 20px;"
      placeholder=" 说几句..."
      bindinput="handleInput"
    />
    <button bindtap="commentPost" style="width:20%;background-color:rgb(212, 88, 30);border-radius:5px 20px 5px 20px;font-size: initial; font-weight: 700;color: white;">发送</button>
  </view>
</view>

