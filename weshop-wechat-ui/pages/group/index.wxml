<import src="/waterfall/waterfall.wxml" />

<!-- 导航栏 -->
<scroll-view scroll-x class="bg-white nav" scroll-with-animation scroll-left="{{scrollLeft}}" style="height:63rpx;">
  <view class="cu-item {{index == TabCur ? 'text-white text-bold' : ''}}" wx:for="{{groupList}}" wx:key="index" bindtap="tabSelect" data-id="{{index}}" data-group="{{item.id}}" style="color:{{index==TabCur?'black':'gray'}};border-radius:{{index==TabCur?'10px 10px 10px 10px;':'10px 10px 10px 10px;'}};height:30px;line-height:30px;font-size:{{index==TabCur?'14px':'10px'}};background-color:{{index==TabCur?'none':'white'}};margin:0;background-color:{{index==TabCur?'#FF9800':'#f3eaea'}};">
    {{item.groupName}}
  </view>
  <view class="cu-item {{index == TabCur ? 'text-white text-bold' : ''}}" bindtap="onJoinButtonClick" style="height:30px;line-height:30px;margin:0;background-color:'#FF9800' ; font-weight: 900;font-size: 14px;color:chocolate; border-bottom: 2px solid rgba(0,0,0,.15)">
    加入新学校+
  </view>
</scroll-view>

<view class="container">
  <scroll-view 
    scroll-y="true" 
    bindscrolltolower="loadMore" 
    style="height: calc(100vh - 63rpx);"
    enhanced="true"
    bounces="true"
  >
    <view class="post-list">
      <block wx:if="{{postsList.length > 0}}">
        <block wx:for="{{postsList}}" wx:key="id" wx:for-item="item">
          <view class="fall-item" bindtap="navigateToDetailPage" data-item="{{item}}" style="background-color: #f5f5f5 !important; border-radius: 12px; margin-bottom: 2px; width: 90%; margin-left: auto; margin-right: auto;  ">
            <view class="fall-li" style="margin-top: 0;">
              <view class="fall-bottom" style="display: flex; flex-direction: column; align-items: flex-start;">
                <view class="fall-toux-name" style="margin-bottom: 8px; align-self: flex-start;">
                  <image class="fall-toux" style="width: 40px; height: 40px;" src="../../image/logo.png"></image>
                  <view style="display: flex; flex-direction: column;">
                    <text class="fall-name" style="font-size:15px;font-weight: bold;">{{item.creator.nickName}}</text>
                    <text class="fall-name" style="font-size:10px">{{item.createTime}}</text>
                  </view>
                </view>
                <view style="margin-bottom: 8px; align-self: flex-start;">
                  <navigator url="url" class="fall-title" style="font-weight: normal;">{{item.content}}
                  </navigator>
                </view>

                <view class="fall-love-num" style="align-self: flex-start;">
                  <text class="cuIcon-comment lg text-gray"></text>
                  <text class="fall-num">{{item.commentNum}}</text>
                  <text style="margin-left: 20px;" class="cuIcon-like lg text-gray"></text>
                  <text class="fall-num">{{item.likeNum}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </block>
      <view wx:else style="text-align: center; color: #999; margin-top: 20px;">
        <view style="display: flex; flex-direction: column; align-items: center; color: #999; margin-top: 100px;">
          <image src="../../static/images/renzhe_icon.png" style="height: 130rpx;width: 130rpx;"></image>
          <!-- <text class="cuIcon-notice text-gray" style="font-size: 24px;"></text> -->
          <text style="margin-top: 10px; color: #999;">恭喜你抢到沙发！</text>
          <text style="color: #999;">该校目前还没有发表内容，快发出第一条吧</text>
        </view>
      </view>
    </view>
    <view wx:if="{{!groupList || groupList.length === 0}}" class="empty-tip" style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 300px;">
      <text class="cuIcon-group lg text-gray" style="font-size: 48px;"></text>
      <text style="color: #999; margin-top: 20px;">还没有加入学校，请先加入</text>
    </view>
  </scroll-view>
</view>

<!-- 悬浮按钮组 -->
<view style="position: fixed; bottom: 40px; right: 20px; z-index: 1000; display: flex; flex-direction: column; gap: 20px;">
  <!-- <add-group bind:click="navigateToPostPage" style="margin-bottom: 20px;"></add-group> -->
  <new-group-post wx:if="{{groupList && groupList.length > 0}}" bind:click="navigateToPostPage"></new-group-post>
</view>


<!-- 弹窗 -->
<view class="modal" wx:if="{{showModal}}">
  <view class="modal-container" style="width: 80%;">
    <view class="modal-content">
      <view class="modal-header">
        <text style="font-weight:bold;font-size: 20px;">认证加入学校小组</text>
      </view>

      <view class="modal-body">
        <!-- 学校选择区域 -->
        <view class="search-container">
          <text class="section-title" style="font-weight:bold;color: dimgray;">选择学校</text>
          <input type="text" placeholder="请输入学校名称" bindinput="onSearchInput" bindfocus="onFocus" bindblur="onBlur" value="{{searchQuery}}" />
          <view class="dropdown-list" wx:if="{{showDropdown && filteredSchools.length > 0}}">
            <view class="dropdown-item" wx:for="{{filteredSchools}}" wx:key="index" data-school="{{item.name}}" data-id="{{item.code}}" bindtap="selectSchool">
              {{item.name}}
            </view>
          </view>
        </view>

        <!-- 图片上传区域 -->
        <view class="image-container">
          <text class="section-title" style="font-weight:bold;color: dimgray; margin-top: 20px; display: block;">认证</text>
          <text class="section-title" style="font-weight:100;font-size:smaller;color:dimgray;/* margin-top:20px; */display:block;">上传证明您是该校学生家长/教职工的真实材料\n仅用于平台审核
          </text>
          <form bindsubmit="formSubmit" bindreset="formReset" class="post-form">
            <view class="image-section" style="display: flex; justify-content: center;">
              <block wx:if="{{images.length > 0 && images.length < 6}}">
                <block wx:for="{{images}}" wx:key="index">
                  <view class="image-container" style="position: relative;" style="display: inline-block;">
                    <image class="image-item" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage"></image>
                    <button class="delete-btn" bindtap="deleteImage" data-index="{{index}}">X
                    </button>
                  </view>
                </block>
              </block>
              <button class="add-image-btn" bindtap="chooseImage" style="width: 100px; height: 100px; font-size: xx-large; margin-top: 2px;background-color: rgb(223, 223, 226);" wx:if="{{images.length === 0}}">+
              </button>
            </view>
          </form>
        </view>
      </view>

      <!-- 底部按钮 -->
      <view class="modal-footer">
        <button class="cancel-btn" bindtap="hideJoinModal" bind:tap="hideJoinModal">取消</button>
        <button class="confirm-btn" bindtap="confirmJoin">确定</button>
      </view>
    </view>
  </view>
</view>